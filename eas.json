{
  "cli": {
    "version": ">= 3.14.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "node": "22.14.0",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "environment": "development"
    },
    "preview": {
      "node": "22.14.0",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "distribution": "internal",
      "channel": "preview",
      "environment": "preview"
    },
    "production":{
      "node": "22.14.0",
      "env": {
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      },
      "channel": "production",
      "environment": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
