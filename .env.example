# ============================================================
# Fichier EXEMPLE - copiez en .env.dev ou .env.prod et remplissez les valeurs
# CE FICHIER EST COMMITTE - ne pas mettre de vraies valeurs ici
# ============================================================

# --- API back-end ---
# Dev local par defaut si absent: http://localhost:8080/api/v1
EXPO_PUBLIC_API_URL_DEV=http://localhost:8080/api/v1
# Requis en build production: pas de fallback code en dur.
EXPO_PUBLIC_API_URL_PROD=https://votre-domaine.fr/api/v1

# --- Firebase ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# --- Sentry (production uniquement) ---
EXPO_PUBLIC_SENTRY_DSN=

# --- OAuth Google (Sign-In) ---
# Web client ID cree par Firebase (Google Cloud Console > Credentials)
# Format : 1234567890-xxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client ID (present dans GoogleService-Info.plist sous CLIENT_ID)
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
