{
  "compilerOptions": {
    "strict": true,
    "isolatedModules": true,
    "forceConsistentCasingInFileNames": true,
    "allowSyntheticDefaultImports": true,
    "checkJs": false,
    "types": [
      "react",
      "react-native",
      "jest"
    ]
  },
  "include": [
    "*.ts",
    "*.tsx",
    "*.js",
    "**/*.ts",
    "**/*.tsx",
    "**/*.js"
  ],
  "extends": "expo/tsconfig.base"
}
